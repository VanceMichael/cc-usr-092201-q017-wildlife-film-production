{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "野生动物故事摄制领域资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "record_types",
    "workflow_states",
    "facts",
    "roles",
    "coordinate_levels",
    "coordinate_rule",
    "usage_constraints",
    "traceability",
    "daily_confirmation",
    "change_triggers",
    "release_checklist",
    "sample"
  ],
  "properties": {
    "domain": {
      "const": "wildlife-film-production"
    },
    "version": {
      "type": "integer",
      "minimum": 2
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "record_types": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    },
    "workflow_states": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "roles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duty",
          "coordinate_access"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "duty": {
            "type": "string",
            "minLength": 1
          },
          "coordinate_access": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "coordinate_levels": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "coordinate_rule": {
      "type": "string",
      "minLength": 1
    },
    "usage_constraints": {
      "type": "object",
      "minProperties": 3
    },
    "traceability": {
      "type": "object",
      "minProperties": 2
    },
    "daily_confirmation": {
      "type": "object",
      "required": [
        "record",
        "timing",
        "confirms"
      ],
      "properties": {
        "record": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "type": "string",
          "minLength": 1
        },
        "confirms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "change_triggers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "event",
          "review"
        ],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "review": {
            "type": "string",
            "minLength": 1
          },
          "recheck": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "release_checklist": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "sample": {
      "type": "object",
      "minProperties": 3
    }
  },
  "additionalProperties": false
}
